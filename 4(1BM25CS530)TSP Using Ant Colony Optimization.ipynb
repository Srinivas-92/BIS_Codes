   "source": [
    "import numpy as np\n",
    "np.random.seed(42)\n",
    "\n",
    "class ACO_TSP:\n",
    "\n",
    "    def __init__(\n",
    "        self,\n",
    "        cities,\n",
    "        num_ants=25,\n",
    "        max_iter=80,\n",
    "        alpha=1.0,\n",
    "        beta=2.5,\n",
    "        rho=0.4,\n",
    "        Q=100,\n",
    "    ):\n",
    "        self.cities = cities\n",
    "        self.num_cities = len(cities)\n",
    "        self.num_ants = num_ants\n",
    "        self.max_iter = max_iter\n",
    "        self.alpha = alpha  
    "        self.beta = beta  ,
    "        self.rho = rho  
    "        self.Q = Q 
    "\n",
    "        # Distance & Heuristic Matrices\n",
    "        self.dist_matrix = np.linalg.norm(\n",
    "            cities[:, np.newaxis] - cities[np.newaxis, :], axis=2\n",
    "        )\n",
    "        np.fill_diagonal(self.dist_matrix, 1e-10)\n",
    "        self.eta = 1.0 / self.dist_matrix\n",
    "        self.tau = np.ones((self.num_cities, self.num_cities))\n",
    "\n",
    "        self.best_tour = None\n",
    "        self.best_length = float(\"inf\")\n",
    "\n",
    "    def run(self):\n",
    "        for _ in range(self.max_iter):\n",
    "            all_tours = []\n",
    "            all_lengths = []\n",
    "\n",
    "            for _ in range(self.num_ants):\n",
    "                tour = self._construct_tour()\n",
    "                length = self._calculate_tour_length(tour)\n",
    "                all_tours.append(tour)\n",
    "                all_lengths.append(length)\n",
    "\n",
    "                if length < self.best_length:\n",
    "                    self.best_length = length\n",
    "                    self.best_tour = tour\n",
    "                    \n",
    "            self.tau *= 1.0 - self.rho\n",
    "            for tour, length in zip(all_tours, all_lengths):\n",
    "                deposit = self.Q / length\n",
    "                for i in range(len(tour)):\n",
    "                    u, v = tour[i], tour[(i + 1) % len(tour)]\n",
    "                    self.tau[u, v] += deposit\n",
    "                    self.tau[v, u] += deposit\n",
    "\n",
    "        return self.best_tour, self.best_length\n",
    "\n",
    "    def _construct_tour(self):\n",
    "        start = np.random.randint(0, self.num_cities)\n",
    "        tour = [start]\n",
    "        unvisited = set(range(self.num_cities)) - {start}\n",
    "\n",
    "        curr = start\n",
    "        while unvisited:\n",
    "            unvisited_list = list(unvisited)\n",
    "            probs = (self.tau[curr, unvisited_list] ** self.alpha) * (\n",
    "                self.eta[curr, unvisited_list] ** self.beta\n",
    "            )\n",
    "            probs_sum = probs.sum()\n",
    "            probs = (\n",
    "                probs / probs_sum\n",
    "                if probs_sum > 0\n",
    "                else np.ones(len(unvisited_list)) / len(unvisited_list)\n",
    "            )\n",
    "\n",
    "            nxt = np.random.choice(unvisited_list, p=probs)\n",
    "            tour.append(nxt)\n",
    "            unvisited.remove(nxt)\n",
    "            curr = nxt\n",
    "        return tour\n",
    "\n",
    "    def _calculate_tour_length(self, tour):\n",
    "        return sum(\n",
    "            self.dist_matrix[tour[i], tour[(i + 1) % len(tour)]]\n",
    "            for i in range(len(tour))\n",
    "        )\n",
    "\n",
    "num_stops = 15\n",
    "locations = np.random.rand(num_stops, 2) * 100\n",
    "\n",
    "aco = ACO_TSP(\n",
    "    cities=locations,\n",
    "    num_ants=25,\n",
    "    max_iter=80,\n",
    "    alpha=1.0,\n",
    "    beta=2.5,\n",
    "    rho=0.4,\n",
    "    Q=100,\n",
    ")\n",
    "best_route, shortest_distance = aco.run()\n",
    "\n",
    "complete_route = best_route + [best_route[0]]\n",
    "\n",
    "print(f\"Optimal Delivery Route: {' -> '.join(map(str, complete_route))}\")\n",
    "print(f\"Total Shortest Distance: {shortest_distance:.2f} km\")"
   ]
